{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codebase Wiki",
  "version": "0.7.2",
  "identifier": "com.codebasewiki.app",
  "build": {
    "beforeDevCommand": "node scripts/build-sidecar.mjs --if-missing && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && node scripts/build-sidecar.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Codebase Wiki",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/codebase-wiki-mcp"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "resources": {
      "../resources/validate-wiki.py": "resources/validate-wiki.py"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE5RTkxMzI5MUJGMzdFREEKUldUYWZ2TWJLUlBwcVRCTFBWOFhBZDJ0clhBSVRRMllxYk1mNGZMWnllVDZ5UlZiY3Z3bytrcDgK",
      "endpoints": [
        "https://github.com/StefanoHernandez/codebase-wiki-app/releases/latest/download/latest.json"
      ]
    }
  }
}
